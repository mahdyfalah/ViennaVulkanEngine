# tetra.obj
# simple regular tetrahedron centered at origin with texture coordinates

o tetra

v 0.500000 0.500000 0.500000
v 0.500000 -0.500000 -0.500000
v -0.500000 0.500000 -0.500000
v -0.500000 -0.500000 0.500000

vt 0.500000 1.000000
vt 0.000000 0.000000
vt 1.000000 0.000000
vt 0.500000 0.500000

f 1/1/1 2/2/2 3/3/3
f 1/1/1 4/4/4 2/2/2
f 2/2/2 4/4/4 3/3/3
f 1/1/1 3/3/3 4/4/4